import java.util.Arrays;

public class PlusOne {
    public static int[] plusOne(int[] digits) {
        int n = digits.length;

        for (int i = n - 1; i >= 0; i--) {
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            digits[i] = 0;
        }

        // Reaching here means all digits were 9 (e.g., [9, 9] -> [1, 0, 0])
        int[] result = new int[n + 1];
        result[0] = 1;
        return result;
    }

    public static void main(String[] args) {
        System.out.println(Arrays.toString(plusOne(new int[]{1, 2, 3}))); // Output: [1, 2, 4]
        System.out.println(Arrays.toString(plusOne(new int[]{4, 3, 2, 9}))); // Output: [4, 3, 3, 0]
        System.out.println(Arrays.toString(plusOne(new int[]{9, 9, 9}))); // Output: [1, 0, 0, 0]
    }
}
